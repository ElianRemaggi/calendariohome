# Shift — copiar a .env y completar (no versionar secretos en repos públicos)

# PostgreSQL (contenedor shift-db en red backend)
POSTGRES_USER=shift_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=shift_db

# NestJS (dentro del contenedor shift-api)
DATABASE_URL=postgresql://shift_user:change_me@shift-db:5432/shift_db
NODE_ENV=production
PORT=3000

# Zona horaria para reglas de día calendario
TZ=America/Argentina/Buenos_Aires

# Nuxt (build / runtime público)
NUXT_PUBLIC_API_BASE=/shift-api

# Legajos con rol ADMIN (coma-separados; también en seed Prisma)
SHIFT_ADMIN_LEGAJOS=9147,7429,8884

# Desarrollo local (docker/shift/docker-compose.yml)
SHIFT_DEV_HTTP_PORT=8081
